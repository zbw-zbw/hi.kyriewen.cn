#!/bin/sh
# 任一步骤失败立即中断提交。
# 没有 set -e 时，hook 的退出码只取最后一条命令 —— lint 失败也照样能提交。
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 对暂存文件跑 prettier
pnpm lint-staged

# ESLint（主站 + Admin）
pnpm lint:all

# TypeScript 类型检查（主站 + Admin，后者开了更严格的 noUncheckedIndexedAccess）
pnpm type-check:all

# 安全不变式回归测试（鉴权、sanitize、fail-closed）
pnpm test
