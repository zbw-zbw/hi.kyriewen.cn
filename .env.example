# ─────────────────────────────────────────────────────────────
# 环境变量模板。复制为 .env.local 后填入真实值。
#
# 安全约定（不是建议，是约定）：
# 1. 主站与 apps/admin 必须使用【不同】的 NEXTAUTH_SECRET。
#    NextAuth 的 JWE 密钥由 HKDF(secret, salt=cookieName) 派生，两边一致
#    就意味着主站签发的会话能直接平移到后台 —— 而主站对任意 GitHub 用户开放登录。
# 2. CRON_SECRET 必须在主站与 admin 两侧【一致】，否则 admin 无法触发主站缓存失效。
# 3. 生产环境必须显式配置 CRON_SECRET：cron 与 revalidate 端点现在是 fail-closed，
#    缺失即拒绝所有请求（而不是像以前那样默认放行）。
# ─────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hi.kyriewen.cn
NEXT_PUBLIC_SITE_NAME=Kyriewen

# ── Database (Neon Postgres) ────────────────────────────────
# 运行时用池化 URL；drizzle-kit push/generate 用非池化直连
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ── GitHub OAuth（留言簿登录 / 后台登录）─────────────────────
# 主站与 admin 建议注册两个独立的 OAuth App（回调域名不同）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 32
# ⚠️ admin 侧必须换成另一个值，见文件顶部第 1 条
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── 仅 apps/admin 需要 ───────────────────────────────────────
# 管理员 GitHub 数字 ID 白名单，逗号分隔。留空 = 任何人都无法登录（fail-closed）
ADMIN_GITHUB_IDS=
# admin 触发主站 cron / revalidate 的目标地址
MAIN_SITE_URL=https://hi.kyriewen.cn

# ── GitHub API（Stats 同步）─────────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ── Last.fm / Spotify（Now 页）──────────────────────────────
LASTFM_API_KEY=
LASTFM_USERNAME=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── Newsletter (Resend) ─────────────────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
NEWSLETTER_FROM_EMAIL=

# ── Cron / 按需缓存失效 ─────────────────────────────────────
# openssl rand -hex 16 —— 主站与 admin 必须填同一个值
CRON_SECRET=

# ── Upstash Redis（限流）────────────────────────────────────
# 未配置时限流器整体降级放行：chat / newsletter / views 会失去配额保护
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI（Chat + 后台翻译）────────────────────────────────────
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=

# ── Cloudflare R2（图片上传，仅 admin 需要）─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.kyriewen.cn

# ── 第三方文章同步 ──────────────────────────────────────────
JUEJIN_USER_ID=
CSDN_USER_ID=

# ── 内容源开关（可选）───────────────────────────────────────
# BLOG_SOURCE=db|file      未设置时优先读库，失败回退文件
# CONTENT_SOURCE=db|file
